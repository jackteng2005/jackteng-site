---
import { ui, type Lang } from '../i18n';
import { nav, navZh } from '../site';
import Logo from './Logo.astro';

/**
 * On narrow screens the section links are dropped rather than collapsed
 * into a JS menu: this is a single scrolling page, so the links are a
 * convenience, not the only route to the content. Keeps the header at
 * zero JavaScript.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const items = lang === 'zh' ? navZh : nav;
const contactHref = lang === 'zh' ? '/zh/#contact' : '/#contact';
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href={t.homeHref}
      class="inline-flex items-center rounded-sm py-2"
      aria-label={t.homeAriaLabel}
    >
      <Logo />
    </a>

    <nav aria-label="Sections" class="hidden md:block">
      <ul class="flex items-center gap-5 lg:gap-7">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-text-muted transition-colors hover:text-text"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={contactHref} class="btn btn-primary shrink-0 !px-4 !py-2.5 text-sm">
      {t.getInTouch}
    </a>
  </div>
</header>
