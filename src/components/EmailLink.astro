---
import { emailEncoded, emailPlain } from '../site';

/**
 * Email call-to-action. Copies the address to the clipboard.
 *
 * Deliberately not a mailto: link. A mailto: does nothing at all on a machine
 * with no registered mail handler — common for anyone who lives in webmail —
 * and it fails silently, so the visitor concludes the site is broken.
 *
 * The address is still kept out of the HTML source: base64 in a data
 * attribute, decoded in the browser. With JavaScript off the button is never
 * revealed and a readable `hello [at] jackteng.com` shows in its place, so the
 * address is never simply missing.
 */
interface Props {
  label?: string;
  variant?: 'primary' | 'secondary' | 'inline';
  class?: string;
}

const { label, variant = 'primary', class: className = '' } = Astro.props;

const variantClass = variant === 'inline' ? 'prose-link' : `btn btn-${variant}`;
---

<span class="js-email-wrap inline-flex flex-col items-start gap-1">
  <button
    type="button"
    hidden
    class={`js-email-copy ${variantClass} ${className}`}
    data-email={emailEncoded}
    data-label={label ?? ''}
  >
    {/* Both labels share one grid cell so the button width is the wider of
        the two and never changes when it swaps to "Copied". They toggle with
        `invisible` (visibility) rather than `hidden` (display: none) — a
        display:none grid item leaves the grid and stops contributing to that
        width, which is exactly the layout shift this avoids. Visibility
        hidden is still ignored by screen readers. */}
    <span class="grid justify-items-center">
      <span class="js-email-idle col-start-1 row-start-1">{label ?? ''}</span>
      <span class="js-email-done invisible col-start-1 row-start-1">
        <span aria-hidden="true">&#10003;</span> <span class="js-email-done-text"></span>
      </span>
    </span>
  </button>

  <span class="js-email-fallback text-sm text-text-muted">{emailPlain}</span>
</span>

<script>
  // Detected once from <html lang>, set server-side per page (see
  // src/i18n.ts) — cheaper than threading a lang prop through every call
  // site for four strings that never appear in the initial HTML anyway.
  const isZh = document.documentElement.lang.startsWith('zh');
  const copy = isZh
    ? {
        copied: '已复制',
        status: (addr: string) => `✓ 已复制 ${addr} — 粘贴到邮件中即可使用`,
        announceCopied: (addr: string) => `${addr} 已复制到剪贴板`,
        announceBlocked: (addr: string) =>
          `当前浏览器不支持自动复制,地址是 ${addr}`,
        ariaLabel: (addr: string) => `复制邮箱地址 ${addr}`,
      }
    : {
        copied: 'Copied',
        status: (addr: string) => `✓ ${addr} copied — paste it into your email`,
        announceCopied: (addr: string) => `${addr} copied to clipboard`,
        announceBlocked: (addr: string) =>
          `Copying is blocked in this browser. The address is ${addr}`,
        ariaLabel: (addr: string) => `Copy email address ${addr}`,
      };

  const decode = (value: string): string | null => {
    try {
      return atob(value);
    } catch {
      return null;
    }
  };

  // One shared live region for every button on the page.
  let live: HTMLElement | null = null;
  const announce = (message: string) => {
    if (!live) {
      live = document.createElement('div');
      live.setAttribute('aria-live', 'polite');
      live.className = 'sr-only';
      document.body.append(live);
    }
    live.textContent = '';
    window.setTimeout(() => {
      if (live) live.textContent = message;
    }, 40);
  };

  const copyText = async (text: string): Promise<boolean> => {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Permission denied or unsupported — fall through.
      }
    }
    // Older browsers, and pages served over plain http.
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '0';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  };

  /**
   * Copy is unavailable (permission denied, or an unfocused document).
   * Show the address next to the button so it can be selected by hand —
   * without overwriting the button's own label, which on the hero CTA is
   * the call to action itself.
   */
  const showManualAddress = (btn: HTMLButtonElement, address: string) => {
    const wrap = btn.parentElement;
    if (!wrap) return;
    let note = wrap.querySelector<HTMLElement>('.js-email-manual');
    if (!note) {
      note = document.createElement('span');
      // `select-all` makes a single click select the whole address.
      note.className = 'js-email-manual select-all text-sm text-text-muted';
      wrap.append(note);
    }
    note.textContent = address;
  };

  document
    .querySelectorAll<HTMLButtonElement>('button.js-email-copy')
    .forEach((btn) => {
      const address = decode(btn.dataset.email ?? '');
      if (!address) return; // Leave the readable fallback in place.

      const idle = btn.querySelector<HTMLElement>('.js-email-idle')!;
      const done = btn.querySelector<HTMLElement>('.js-email-done')!;
      const doneText = btn.querySelector<HTMLElement>('.js-email-done-text')!;
      doneText.textContent = copy.copied;

      // Buttons with no explicit label display the address itself.
      if (!btn.dataset.label) idle.textContent = address;

      btn.setAttribute('aria-label', copy.ariaLabel(address));
      btn.hidden = false;

      // The plain-text fallback exists only for the no-JS case.
      btn.parentElement?.querySelector('.js-email-fallback')?.remove();

      let timer: number | undefined;

      btn.addEventListener('click', async () => {
        const ok = await copyText(address);

        if (!ok) {
          showManualAddress(btn, address);
          announce(copy.announceBlocked(address));
          return;
        }

        idle.classList.add('invisible');
        done.classList.remove('invisible');
        announce(copy.announceCopied(address));

        // The button label reverts after a moment so it reads as clickable
        // again, but a first-time visitor needs to know *what* was copied and
        // what to do with it — so this line is written once and left in place.
        const wrap = btn.parentElement;
        if (wrap) {
          let status = wrap.querySelector<HTMLElement>('.js-email-status');
          if (!status) {
            status = document.createElement('span');
            // Not aria-live: the shared live region already announced it, and
            // two announcements for one action is worse than none.
            status.className =
              'js-email-status text-sm font-medium text-accent-strong';
            wrap.append(status);
          }
          status.textContent = copy.status(address);
        }

        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          done.classList.add('invisible');
          idle.classList.remove('invisible');
        }, 2200);
      });
    });

  // Upgrade any inline obfuscated address to the real one.
  document.querySelectorAll<HTMLElement>('.js-email-text').forEach((el) => {
    const address = decode(el.dataset.email ?? '');
    if (address) el.textContent = address;
  });
</script>
