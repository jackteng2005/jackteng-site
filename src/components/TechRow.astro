---
/**
 * Technology chips.
 *
 * This is the honest version of the "proof strip" that agency sites put under
 * the hero. Stat rows ("100+ automations built") require a track record;
 * naming the tools you actually work with does not, and it signals technical
 * range to a prospect within the first screen.
 *
 * Everything listed is a tool Jack actually works with — confirmed by him, or
 * evidenced by this repository. Keep it that way: anything named here can be
 * asked about in a discovery call, and a padded list is worse than a short one
 * because technical prospects spot it.
 *
 * Add the host (Netlify or Vercel) to "Data & platform" once deployed.
 */
const groups: { label: string; items: string[] }[] = [
  {
    label: 'Build',
    items: ['TypeScript', 'Node.js', 'Astro', 'Tailwind CSS', 'Git'],
  },
  {
    label: 'Data & platform',
    items: ['Firebase', 'Google Workspace'],
  },
  {
    label: 'AI',
    items: ['Claude', 'OpenAI API', 'Cursor', 'Codex', 'Lovable'],
  },
].filter((g) => g.items.length > 0);
---

{
  groups.length > 0 && (
    <div class="mt-16 border-t border-border pt-10" data-reveal>
      <p class="text-xs font-medium tracking-wide text-text-muted uppercase">
        Tools I work with
      </p>

      <div class="mt-6 space-y-5">
        {groups.map((group) => (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
            {groups.length > 1 && (
              <span class="w-24 shrink-0 text-xs font-semibold text-accent-strong">
                {group.label}
              </span>
            )}
            {group.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        ))}
      </div>
    </div>
  )
}
