---
import type { Lang } from '../i18n';

/**
 * Technology chips.
 *
 * This is the honest version of the "proof strip" that agency sites put under
 * the hero. Stat rows ("100+ automations built") require a track record;
 * naming the tools you actually work with does not, and it signals technical
 * range to a prospect within the first screen.
 *
 * Everything listed is a tool Jack actually works with — confirmed by him, or
 * evidenced by this repository. Keep it that way: anything named here can be
 * asked about in a discovery call, and a padded list is worse than a short one
 * because technical prospects spot it.
 *
 * Add the host (Netlify or Vercel) to "Data & platform" once deployed.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const groupsEn: { label: string; items: string[] }[] = [
  {
    label: 'Build',
    items: ['TypeScript', 'Node.js', 'Astro', 'Tailwind CSS', 'Git'],
  },
  {
    label: 'Data & platform',
    items: ['Firebase', 'Google Workspace'],
  },
  {
    label: 'AI',
    items: ['Claude', 'OpenAI API', 'Cursor', 'Codex', 'Lovable'],
  },
].filter((g) => g.items.length > 0);

const groupsZh: { label: string; items: string[] }[] = [
  {
    label: '开发',
    items: ['TypeScript', 'Node.js', 'Astro', 'Tailwind CSS', 'Git'],
  },
  {
    label: '数据与平台',
    items: ['Firebase', 'Google Workspace'],
  },
  {
    label: 'AI',
    items: ['Claude', 'OpenAI API', 'Cursor', 'Codex', 'Lovable'],
  },
].filter((g) => g.items.length > 0);

const groups = lang === 'zh' ? groupsZh : groupsEn;
const heading = lang === 'zh' ? '使用的技术' : 'Tools I work with';
---

{
  groups.length > 0 && (
    <div class="mt-12 border-t border-border pt-8 sm:mt-16 sm:pt-10" data-reveal>
      <p class="text-xs font-medium tracking-wide text-text-muted uppercase">
        {heading}
      </p>

      {/* The label and the chips are separate flex containers. Previously the
          label shared one wrapping row with the chips, so the first row began
          after the label while every wrapped row began at the container edge —
          ragged on any screen narrow enough to wrap. Below `sm` the label sits
          on its own line, because a fixed label column ate a third of the
          width on a phone. */}
      <div class="mt-6 space-y-6 sm:space-y-5">
        {groups.map((group) => (
          <div class="sm:flex sm:items-start sm:gap-4">
            {groups.length > 1 && (
              <span class="block text-xs font-semibold text-accent-strong sm:w-28 sm:shrink-0 sm:pt-2">
                {group.label}
              </span>
            )}
            <div class="mt-3 flex flex-wrap gap-2.5 sm:mt-0">
              {group.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
