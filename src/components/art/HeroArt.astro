---
/**
 * Hero composition: layered application surfaces with a connected data
 * path. Deliberately abstract — it signals "systems and interfaces" without
 * pretending to be a screenshot of a real product.
 *
 * Themed via Tailwind colour utilities mapped to the design tokens, so it
 * follows light/dark automatically. Decorative, so hidden from assistive tech.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 640 520"
  fill="none"
  aria-hidden="true"
  class={`h-auto w-full ${className}`}
>
  <defs>
    <pattern id="ha-dots" width="18" height="18" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.5" class="fill-current" opacity="0.16" />
    </pattern>

    <radialGradient id="ha-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" class="text-accent" stop-color="currentColor" stop-opacity="0.34" />
      <stop offset="100%" class="text-accent" stop-color="currentColor" stop-opacity="0" />
    </radialGradient>

    <linearGradient id="ha-panel" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" class="text-accent" stop-color="currentColor" stop-opacity="0.16" />
      <stop offset="100%" class="text-accent" stop-color="currentColor" stop-opacity="0.02" />
    </linearGradient>

    <clipPath id="ha-window">
      <rect x="112" y="128" width="392" height="268" rx="14" />
    </clipPath>
  </defs>

  <!-- ambient field -->
  <g class="text-text-muted">
    <rect x="0" y="0" width="640" height="520" fill="url(#ha-dots)" />
  </g>
  <ellipse cx="470" cy="150" rx="215" ry="185" fill="url(#ha-glow)" />

  <!-- stacked surfaces behind the main window -->
  <rect
    x="164"
    y="96"
    width="352"
    height="252"
    rx="14"
    class="fill-surface stroke-border"
    stroke-width="1.5"
    opacity="0.45"
  />
  <rect
    x="138"
    y="112"
    width="372"
    height="260"
    rx="14"
    class="fill-surface stroke-border"
    stroke-width="1.5"
    opacity="0.72"
  />

  <!-- primary application window -->
  <g>
    <rect
      x="112"
      y="128"
      width="392"
      height="268"
      rx="14"
      class="fill-surface stroke-control-border"
      stroke-width="1.5"
    />

    <g clip-path="url(#ha-window)">
      <!-- title bar -->
      <rect x="112" y="128" width="392" height="34" class="fill-surface-sunken" />
      <line x1="112" y1="162" x2="504" y2="162" class="stroke-border" stroke-width="1.5" />
      <circle cx="130" cy="145" r="3.5" class="fill-accent" />
      <circle cx="143" cy="145" r="3.5" class="fill-border-strong" />
      <circle cx="156" cy="145" r="3.5" class="fill-border-strong" />
      <rect x="188" y="140" width="92" height="9" rx="4.5" class="fill-border" />

      <!-- side rail -->
      <rect x="112" y="162" width="86" height="234" class="fill-surface-sunken" />
      <line x1="198" y1="162" x2="198" y2="396" class="stroke-border" stroke-width="1.5" />
      <rect x="126" y="182" width="56" height="8" rx="4" class="fill-accent" opacity="0.8" />
      <rect x="126" y="204" width="46" height="8" rx="4" class="fill-border-strong" />
      <rect x="126" y="226" width="52" height="8" rx="4" class="fill-border-strong" />
      <rect x="126" y="248" width="40" height="8" rx="4" class="fill-border-strong" />

      <!-- content: stat tiles -->
      <rect x="218" y="182" width="80" height="52" rx="8" fill="url(#ha-panel)" class="stroke-border" stroke-width="1.25" />
      <rect x="230" y="196" width="34" height="7" rx="3.5" class="fill-border-strong" />
      <rect x="230" y="211" width="22" height="11" rx="3" class="fill-accent" />

      <rect x="308" y="182" width="80" height="52" rx="8" fill="url(#ha-panel)" class="stroke-border" stroke-width="1.25" />
      <rect x="320" y="196" width="40" height="7" rx="3.5" class="fill-border-strong" />
      <rect x="320" y="211" width="18" height="11" rx="3" class="fill-accent" opacity="0.72" />

      <rect x="398" y="182" width="80" height="52" rx="8" fill="url(#ha-panel)" class="stroke-border" stroke-width="1.25" />
      <rect x="410" y="196" width="30" height="7" rx="3.5" class="fill-border-strong" />
      <rect x="410" y="211" width="26" height="11" rx="3" class="fill-accent" opacity="0.5" />

      <!-- trend line -->
      <polyline
        points="222,320 262,300 302,308 342,276 382,286 422,254 466,262"
        class="stroke-accent"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="422" cy="254" r="4" class="fill-accent" />
      <line x1="218" y1="352" x2="478" y2="352" class="stroke-border" stroke-width="1.5" />

      <!-- table skeleton -->
      <rect x="218" y="366" width="120" height="8" rx="4" class="fill-border-strong" />
      <rect x="352" y="366" width="62" height="8" rx="4" class="fill-border" />
      <rect x="428" y="366" width="50" height="8" rx="4" class="fill-border" />
    </g>
  </g>

  <!-- floating card: automated message -->
  <g>
    <rect
      x="404"
      y="330"
      width="196"
      height="86"
      rx="12"
      class="fill-surface stroke-control-border"
      stroke-width="1.5"
    />
    <circle cx="430" cy="356" r="11" class="fill-accent" opacity="0.16" />
    <path
      d="M425 356.5l3.5 3.5 6.5-7"
      class="stroke-accent"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <rect x="450" y="348" width="108" height="8" rx="4" class="fill-border-strong" />
    <rect x="450" y="362" width="72" height="7" rx="3.5" class="fill-border" />
    <rect x="424" y="386" width="152" height="7" rx="3.5" class="fill-border" />
    <rect x="424" y="399" width="106" height="7" rx="3.5" class="fill-border" />
  </g>

  <!-- connected nodes down the left edge -->
  <g class="stroke-accent" stroke-width="1.75" stroke-linecap="round">
    <path d="M62 224v112" stroke-dasharray="5 7" opacity="0.6" />
    <path d="M62 336c0 26 22 30 46 30" opacity="0.6" />
  </g>
  <g>
    <circle cx="62" cy="208" r="15" class="fill-surface stroke-accent" stroke-width="1.75" />
    <circle cx="62" cy="208" r="4.5" class="fill-accent" />
    <circle cx="62" cy="352" r="15" class="fill-surface stroke-accent" stroke-width="1.75" />
    <circle cx="62" cy="352" r="4.5" class="fill-accent" opacity="0.6" />
  </g>
</svg>
