---
/**
 * Stylised operations dashboard.
 *
 * Intentionally text-free: it reads as an interface at any size, stays
 * legible when scaled down on mobile (unlike a wide SVG carrying labels),
 * and cannot be mistaken for a screenshot of a real client system.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const bars = [38, 56, 44, 72, 61, 88, 70, 96, 82, 104];
---

<svg
  viewBox="0 0 720 480"
  fill="none"
  aria-hidden="true"
  class={`h-auto w-full ${className}`}
>
  <defs>
    <linearGradient id="da-bar" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" class="text-accent" stop-color="currentColor" stop-opacity="0.35" />
      <stop offset="100%" class="text-accent" stop-color="currentColor" stop-opacity="1" />
    </linearGradient>

    <linearGradient id="da-area" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" class="text-accent" stop-color="currentColor" stop-opacity="0.28" />
      <stop offset="100%" class="text-accent" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>

    <clipPath id="da-clip">
      <rect x="8" y="8" width="704" height="464" rx="16" />
    </clipPath>
  </defs>

  <!-- frame -->
  <rect
    x="8"
    y="8"
    width="704"
    height="464"
    rx="16"
    class="fill-surface stroke-control-border"
    stroke-width="1.5"
  />

  <g clip-path="url(#da-clip)">
    <!-- top bar -->
    <rect x="8" y="8" width="704" height="46" class="fill-surface-sunken" />
    <line x1="8" y1="54" x2="712" y2="54" class="stroke-border" stroke-width="1.5" />
    <rect x="30" y="24" width="14" height="14" rx="4" class="fill-accent" />
    <rect x="54" y="27" width="74" height="9" rx="4.5" class="fill-border-strong" />
    <rect x="556" y="25" width="76" height="13" rx="6.5" class="fill-accent" opacity="0.22" />
    <circle cx="664" cy="31" r="12" class="fill-border" />

    <!-- side rail -->
    <rect x="8" y="54" width="112" height="418" class="fill-surface-sunken" />
    <line x1="120" y1="54" x2="120" y2="472" class="stroke-border" stroke-width="1.5" />
    <rect x="24" y="80" width="80" height="26" rx="7" class="fill-accent" opacity="0.14" />
    <rect x="34" y="89" width="8" height="8" rx="2" class="fill-accent" />
    <rect x="50" y="89" width="44" height="8" rx="4" class="fill-accent" opacity="0.85" />
    {
      [124, 158, 192, 226, 260].map((y, i) => (
        <g>
          <rect x="34" y={y} width="8" height="8" rx="2" class="fill-border-strong" />
          <rect
            x="50"
            y={y}
            width={[46, 38, 52, 34, 44][i]}
            height="8"
            rx="4"
            class="fill-border-strong"
          />
        </g>
      ))
    }

    <!-- stat tiles -->
    {
      [0, 1, 2].map((i) => (
        <g>
          <rect
            x={146 + i * 184}
            y={78}
            width="164"
            height="78"
            rx="10"
            class="fill-surface stroke-border"
            stroke-width="1.25"
          />
          <rect
            x={162 + i * 184}
            y={94}
            width={[52, 62, 44][i]}
            height="7"
            rx="3.5"
            class="fill-border-strong"
          />
          <rect
            x={162 + i * 184}
            y={110}
            width={[46, 34, 40][i]}
            height="16"
            rx="4"
            class="fill-accent"
            opacity={[1, 0.72, 0.48][i]}
          />
          <rect
            x={162 + i * 184}
            y={136}
            width={[86, 70, 78][i]}
            height="6"
            rx="3"
            class="fill-border"
          />
        </g>
      ))
    }

    <!-- chart card -->
    <rect
      x="146"
      y="176"
      width="348"
      height="188"
      rx="10"
      class="fill-surface stroke-border"
      stroke-width="1.25"
    />
    <rect x="164" y="194" width="72" height="8" rx="4" class="fill-border-strong" />
    <path
      d="M164 330 L164 300 Q214 286 264 296 Q314 306 364 274 Q414 246 476 258 L476 330 Z"
      fill="url(#da-area)"
    />
    <polyline
      points="164,300 214,286 264,296 314,306 364,274 414,246 476,258"
      class="stroke-accent"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="414" cy="246" r="4.5" class="fill-accent" />
    <line x1="164" y1="330" x2="476" y2="330" class="stroke-border" stroke-width="1.5" />
    {
      [0, 1, 2, 3, 4, 5].map((i) => (
        <rect x={166 + i * 52} y="340" width="26" height="6" rx="3" class="fill-border" />
      ))
    }

    <!-- capacity card with bars -->
    <rect
      x="510"
      y="176"
      width="184"
      height="188"
      rx="10"
      class="fill-surface stroke-border"
      stroke-width="1.25"
    />
    <rect x="528" y="194" width="60" height="8" rx="4" class="fill-border-strong" />
    {
      bars.map((h, i) => (
        <rect
          x={528 + i * 15}
          y={330 - h}
          width="9"
          height={h}
          rx="3"
          fill="url(#da-bar)"
        />
      ))
    }
    <line x1="528" y1="330" x2="678" y2="330" class="stroke-border" stroke-width="1.5" />
    <rect x="528" y="342" width="112" height="6" rx="3" class="fill-border" />

    <!-- table -->
    <rect
      x="146"
      y="384"
      width="548"
      height="72"
      rx="10"
      class="fill-surface stroke-border"
      stroke-width="1.25"
    />
    {
      [0, 1].map((row) => (
        <g>
          <rect
            x="164"
            y={402 + row * 26}
            width={[104, 86][row]}
            height="8"
            rx="4"
            class="fill-border-strong"
          />
          <rect
            x="316"
            y={402 + row * 26}
            width={[58, 66][row]}
            height="8"
            rx="4"
            class="fill-border"
          />
          <rect
            x="452"
            y={400 + row * 26}
            width="62"
            height="12"
            rx="6"
            class="fill-accent"
            opacity={row === 0 ? 0.24 : 0.12}
          />
          <rect
            x="588"
            y={402 + row * 26}
            width="72"
            height="8"
            rx="4"
            class="fill-border"
          />
        </g>
      ))
    }
  </g>
</svg>
