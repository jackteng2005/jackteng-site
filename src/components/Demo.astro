---
import type { Lang } from '../i18n';

/**
 * Interactive demonstration: event registration with automated follow-up.
 *
 * Entirely client-side. Nothing is sent anywhere, nothing is stored, and
 * the data is fictional — all stated plainly in the UI, because a demo
 * that looks like a real venue's system would be misleading.
 *
 * Deliberately generic rather than modelled on any one kind of
 * organisation — "Thursday Night Session" reads as plausible for a club, a
 * community hall, an association or a venue, rather than narrowing the
 * pitch to one of them.
 *
 * The point for a prospect is the three-panel structure: what the member
 * sees, what happens automatically, and what staff see. That is the
 * actual product being sold.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const CAPACITY = 120;
const SEEDED = 86;

const seedRows = isZh
  ? [
      { name: '陈 (A. Chen)', guests: 1, status: '已确认', when: '周一 09:14' },
      { name: '刘 (L. Liu)', guests: 0, status: '已确认', when: '周一 11:02' },
      { name: '黄 (H. Huang)', guests: 2, status: '待付款', when: '周二 08:47' },
      { name: '王 (W. Wang)', guests: 0, status: '已确认', when: '周二 19:23' },
    ]
  : [
      { name: 'A. Nguyen', guests: 1, status: 'Confirmed', when: 'Mon 09:14' },
      { name: 'D. Okafor', guests: 0, status: 'Confirmed', when: 'Mon 11:02' },
      { name: 'S. Bianchi', guests: 2, status: 'Awaiting payment', when: 'Tue 08:47' },
      { name: 'L. Ferreira', guests: 0, status: 'Confirmed', when: 'Tue 19:23' },
    ];

const t = isZh
  ? {
      bannerStrong: '这是一个演示。',
      banner: '虚构场馆,虚构数据。全部在您的浏览器中运行,不会上传或保存任何信息。',
      step1: '1 — 会员看到的界面',
      eventTitle: '周四晚场活动',
      eventVenue: '河畔礼堂',
      eventTime: '晚上 7:00',
      remainingSuffix: (cap: number) => ` / 共 ${cap} 个名额`,
      formName: '姓名',
      formEmail: '邮箱',
      formGuests: '同行人数',
      guestOptions: ['仅我一人', '1位同行', '2位同行', '3位同行'],
      submit: '立即报名此活动',
      step2: '2 — 系统自动处理的内容',
      idleBody:
        '提交表单后,您会看到接下来自动触发的流程:会员收到的确认信息、活动前的提醒、活动后的跟进,以及工作人员看到的新增记录。',
      idleList: [
        '不需要更新Excel表格',
        '不需要手动发送确认邮件',
        '活动结束后不需要再追着未到场的人',
      ],
      step3: '3 — 工作人员看到的界面',
      tableCaption: '周四晚场活动的报名记录',
      thMember: '会员',
      thGuests: '同行人数',
      thStatus: '状态',
      thReceived: '提交时间',
      resetBtn: '重置演示',
      errorName: '请输入姓名以继续。',
      errorEmail: '请输入有效的邮箱地址以继续。',
      resultHeading: (places: number) =>
        `已预订 ${places} 个名额 — 以下是系统自动触发的全部流程`,
      confirmedStatus: '已确认',
    }
  : {
      bannerStrong: 'Demonstration.',
      banner:
        'Fictional venue, fictional data. Everything runs in your browser — nothing is sent or stored.',
      step1: '1 — What the member sees',
      eventTitle: 'Thursday Night Session',
      eventVenue: 'Riverside Hall',
      eventTime: '7:00pm',
      remainingSuffix: (cap: number) => ` of ${cap} places remaining`,
      formName: 'Full name',
      formEmail: 'Email',
      formGuests: 'Guests',
      guestOptions: ['Just me', '1 guest', '2 guests', '3 guests'],
      submit: 'Register for this event',
      step2: '2 — What happens automatically',
      idleBody:
        "Submit the form to see the sequence that would fire: the member's confirmation, the reminder before the event, the follow-up afterwards, and the row that appears for staff.",
      idleList: [
        'No spreadsheet to update',
        'No manual confirmation emails',
        'No chasing no-shows after the event',
      ],
      step3: '3 — What staff see',
      tableCaption: 'Registrations for Thursday Night Session',
      thMember: 'Member',
      thGuests: 'Guests',
      thStatus: 'Status',
      thReceived: 'Received',
      resetBtn: 'Reset demo',
      errorName: 'Enter a name to continue.',
      errorEmail: 'Enter a valid email address to continue.',
      resultHeading: (places: number) =>
        `${places} place${places > 1 ? 's' : ''} booked — here is everything that fired`,
      confirmedStatus: 'Confirmed',
    };
---

<div
  class="card overflow-hidden shadow-card"
  data-demo
  data-capacity={CAPACITY}
  data-seeded={SEEDED}
  data-lang={lang}
>
  <p
    class="border-b border-border bg-accent-wash px-5 py-3 text-sm text-text-muted"
  >
    <strong class="font-semibold text-text">{t.bannerStrong}</strong>
    {' '}{t.banner}
  </p>

  <div class="grid gap-0 lg:grid-cols-2">
    <!-- ── Member-facing ─────────────────────────────────────────── -->
    <div class="border-border p-6 sm:p-8 lg:border-r">
      <p class="eyebrow">{t.step1}</p>

      <div class="mt-5 rounded-lg border border-border bg-surface-sunken p-5">
        <h3 class="font-display text-lg font-bold">
          {t.eventTitle}
        </h3>
        <p class="mt-1 text-sm text-text-muted">
          {t.eventVenue} &middot; <span data-demo-date>{isZh ? '周四' : 'Thursday'}</span> &middot;
          {t.eventTime}
        </p>
        <p class="mt-3 text-sm">
          <span class="font-semibold" data-demo-remaining>{CAPACITY - SEEDED}</span>
          <span class="text-text-muted">{t.remainingSuffix(CAPACITY)}</span>
        </p>
      </div>

      <form class="mt-6 space-y-4" data-demo-form novalidate>
        <div>
          <label
            for="demo-name"
            class="block text-sm font-medium">{t.formName}</label
          >
          <input
            id="demo-name"
            name="name"
            type="text"
            autocomplete="off"
            required
            class="field mt-1.5"
          />
        </div>

        <div>
          <label for="demo-email" class="block text-sm font-medium">{t.formEmail}</label>
          <input
            id="demo-email"
            name="email"
            type="email"
            autocomplete="off"
            required
            class="field mt-1.5"
          />
        </div>

        <div>
          <label for="demo-guests" class="block text-sm font-medium"
            >{t.formGuests}</label
          >
          <select
            id="demo-guests"
            name="guests"
            class="field mt-1.5"
          >
            <option value="0">{t.guestOptions[0]}</option>
            <option value="1">{t.guestOptions[1]}</option>
            <option value="2">{t.guestOptions[2]}</option>
            <option value="3">{t.guestOptions[3]}</option>
          </select>
        </div>

        <p
          class="hidden text-sm text-danger"
          data-demo-error
          role="alert"
        >
        </p>

        <button type="submit" class="btn btn-primary w-full">
          {t.submit}
        </button>
      </form>
    </div>

    <!-- ── Automation + staff view ───────────────────────────────── -->
    <div class="bg-surface-sunken p-6 sm:p-8">
      <div data-demo-idle>
        <p class="eyebrow">{t.step2}</p>
        <p class="mt-5 text-sm leading-relaxed text-text-muted">
          {t.idleBody}
        </p>
        <ul class="mt-6 space-y-3 text-sm text-text-muted">
          {t.idleList.map((item) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="text-accent">&#9679;</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div data-demo-result hidden aria-live="polite">
        <p class="eyebrow">{t.step2}</p>
        <h3
          class="mt-3 font-display text-lg font-bold"
          data-demo-result-heading
          tabindex="-1"
        >
        </h3>

        <ol class="mt-6 space-y-4" data-demo-timeline></ol>

        <p class="eyebrow mt-10">{t.step3}</p>
        <div class="mt-4 overflow-x-auto rounded-lg border border-border bg-surface">
          <table class="w-full min-w-[26rem] text-left text-sm">
            <caption class="sr-only">
              {t.tableCaption}
            </caption>
            <thead class="border-b border-border text-xs uppercase tracking-wide text-text-muted">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-semibold">{t.thMember}</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">{t.thGuests}</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">{t.thStatus}</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">{t.thReceived}</th>
              </tr>
            </thead>
            <tbody data-demo-rows>
              {
                seedRows.map((r) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-4 py-2.5">{r.name}</td>
                    <td class="px-4 py-2.5">{r.guests}</td>
                    <td class="px-4 py-2.5 text-text-muted">{r.status}</td>
                    <td class="px-4 py-2.5 text-text-muted">{r.when}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <button type="button" class="btn btn-secondary mt-6" data-demo-reset>
          {t.resetBtn}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo]');

  if (root) {
    const isZh = root.dataset.lang === 'zh';

    const form = root.querySelector<HTMLFormElement>('[data-demo-form]')!;
    const idle = root.querySelector<HTMLElement>('[data-demo-idle]')!;
    const result = root.querySelector<HTMLElement>('[data-demo-result]')!;
    const heading = root.querySelector<HTMLElement>('[data-demo-result-heading]')!;
    const timeline = root.querySelector<HTMLElement>('[data-demo-timeline]')!;
    const rows = root.querySelector<HTMLElement>('[data-demo-rows]')!;
    const remaining = root.querySelector<HTMLElement>('[data-demo-remaining]')!;
    const dateLabel = root.querySelector<HTMLElement>('[data-demo-date]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-demo-error]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-demo-reset]')!;

    const capacity = Number(root.dataset.capacity ?? 120);
    const seeded = Number(root.dataset.seeded ?? 0);

    const copy = isZh
      ? {
          errorName: '请输入姓名以继续。',
          errorEmail: '请输入有效的邮箱地址以继续。',
          resultHeading: (places: number) =>
            `已预订 ${places} 个名额 — 以下是系统自动触发的全部流程`,
          confirmed: '已确认',
          immediately: '立即',
          toMember: '发送给会员的邮件',
          toStaff: '发送给工作人员的通知',
          confirmedTitle: '报名已确认',
          loggedTitle: '新报名已记录',
          reminderChannel: '发送给会员的短信 + 邮件',
          reminderTitle: '活动前24小时提醒',
          followUpChannel: '发送给会员的邮件',
          followUpTitle: '跟进与再次预订',
          confirmedBody: (
            firstName: string,
            date: string,
            guests: number
          ) =>
            `${firstName}您好,您已成功报名「周四晚场活动」,时间为${date}晚上7:00${guests ? `,另有${guests}位同行` : ''}。名额将为您保留至18:45。`,
          loggedBody: (name: string, places: number, taken: number, cap: number) =>
            `${name} — 共${places}位。活动当前名额:${taken}/${cap}。`,
          reminderBody:
            '提醒:您明天晚上7:00的名额已确认。回复“取消”即可释放名额,系统会自动通知候补人员。',
          followUpBody: (firstName: string) =>
            `谢谢您的到场,${firstName}。下周活动已开放报名,一键即可预订同样的位置。`,
        }
      : {
          errorName: 'Enter a name to continue.',
          errorEmail: 'Enter a valid email address to continue.',
          resultHeading: (places: number) =>
            `${places} place${places > 1 ? 's' : ''} booked — here is everything that fired`,
          confirmed: 'Confirmed',
          immediately: 'Immediately',
          toMember: 'Email to member',
          toStaff: 'Notification to staff',
          confirmedTitle: 'Registration confirmed',
          loggedTitle: 'New registration logged',
          reminderChannel: 'SMS + email to member',
          reminderTitle: 'Reminder, 24 hours out',
          followUpChannel: 'Email to member',
          followUpTitle: 'Follow-up and rebooking',
          confirmedBody: (
            firstName: string,
            date: string,
            guests: number
          ) =>
            `Hi ${firstName}, you're registered for the Thursday Night Session on ${date} at 7:00pm${guests ? `, plus ${guests} guest${guests > 1 ? 's' : ''}` : ''}. Your place is held until 6:45pm.`,
          loggedBody: (name: string, places: number, taken: number, cap: number) =>
            `${name} — ${places} place${places > 1 ? 's' : ''}. Event now at ${taken} of ${cap}.`,
          reminderBody:
            'Reminder: your place is confirmed for tomorrow at 7:00pm. Reply CANCEL to release it — it goes to the waitlist automatically.',
          followUpBody: (firstName: string) =>
            `Thanks for coming, ${firstName}. Next week's event is open for registration — one tap to book the same spot.`,
        };

    /** Next Thursday, so the demo never reads as stale. */
    const eventDate = (() => {
      const d = new Date();
      d.setDate(d.getDate() + ((4 - d.getDay() + 7) % 7 || 7));
      return d;
    })();

    const locale = isZh ? 'zh-CN' : 'en-AU';

    const fmtDate = new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    const fmtShort = new Intl.DateTimeFormat(locale, {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
    });
    const fmtTime = new Intl.DateTimeFormat(locale, {
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });

    dateLabel.textContent = fmtDate.format(eventDate);

    const dayBefore = new Date(eventDate);
    dayBefore.setDate(dayBefore.getDate() - 1);
    const dayAfter = new Date(eventDate);
    dayAfter.setDate(dayAfter.getDate() + 1);

    let taken = seeded;

    const step = (
      when: string,
      channel: string,
      title: string,
      bodyText: string
    ) => {
      const li = document.createElement('li');
      li.className = 'rounded-lg border border-border bg-surface p-4';
      li.innerHTML = `
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="font-display text-sm font-semibold"></span>
          <span class="text-xs text-text-muted"></span>
        </div>
        <p class="mt-1 text-xs font-medium text-accent-strong"></p>
        <p class="mt-2 text-sm leading-relaxed text-text-muted"></p>`;
      const [t, w] = li.querySelectorAll('span');
      const [ch, bd] = li.querySelectorAll('p');
      t.textContent = title;
      w.textContent = when;
      ch.textContent = channel;
      bd.textContent = bodyText;
      timeline.append(li);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const guests = Number(data.get('guests') ?? 0);

      // Validate here rather than relying on the browser, so the message
      // sits in a predictable place for screen readers.
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errorBox.textContent = !name ? copy.errorName : copy.errorEmail;
        errorBox.classList.remove('hidden');
        (!name
          ? form.querySelector<HTMLInputElement>('#demo-name')
          : form.querySelector<HTMLInputElement>('#demo-email')
        )?.focus();
        return;
      }

      errorBox.classList.add('hidden');

      const places = 1 + guests;
      taken = Math.min(capacity, taken + places);
      remaining.textContent = String(capacity - taken);

      const firstName = isZh ? name : name.split(/\s+/)[0];

      timeline.replaceChildren();

      step(
        copy.immediately,
        copy.toMember,
        copy.confirmedTitle,
        copy.confirmedBody(firstName, fmtDate.format(eventDate), guests)
      );

      step(
        copy.immediately,
        copy.toStaff,
        copy.loggedTitle,
        copy.loggedBody(name, places, taken, capacity)
      );

      step(
        fmtShort.format(dayBefore),
        copy.reminderChannel,
        copy.reminderTitle,
        copy.reminderBody
      );

      step(
        fmtShort.format(dayAfter),
        copy.followUpChannel,
        copy.followUpTitle,
        copy.followUpBody(firstName)
      );

      const tr = document.createElement('tr');
      tr.className = 'border-b border-border last:border-0 bg-accent-wash';
      const cells = [name, String(guests), copy.confirmed, fmtTime.format(new Date())];
      cells.forEach((value, i) => {
        const td = document.createElement('td');
        td.className = i >= 2 ? 'px-4 py-2.5 text-text-muted' : 'px-4 py-2.5';
        if (i === 0) td.classList.add('font-medium');
        td.textContent = value;
        tr.append(td);
      });
      rows.append(tr);

      heading.textContent = copy.resultHeading(places);

      idle.hidden = true;
      result.hidden = false;
      heading.focus();
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      timeline.replaceChildren();
      rows.querySelectorAll('tr').forEach((tr, i) => {
        if (i >= 4) tr.remove();
      });
      taken = seeded;
      remaining.textContent = String(capacity - taken);
      result.hidden = true;
      idle.hidden = false;
      form.querySelector<HTMLInputElement>('#demo-name')?.focus();
    });
  }
</script>
