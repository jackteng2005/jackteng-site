---
/**
 * Interactive demonstration: event registration with automated follow-up.
 *
 * Entirely client-side. Nothing is sent anywhere, nothing is stored, and
 * the data is fictional — all stated plainly in the UI, because a demo
 * that looks like a real club's system would be misleading.
 *
 * The point for a prospect is the three-panel structure: what the member
 * sees, what happens automatically, and what staff see. That is the
 * actual product being sold.
 */
const CAPACITY = 120;
const SEEDED = 86;

const seedRows = [
  { name: 'A. Nguyen', guests: 1, status: 'Confirmed', when: 'Mon 09:14' },
  { name: 'D. Okafor', guests: 0, status: 'Confirmed', when: 'Mon 11:02' },
  { name: 'S. Bianchi', guests: 2, status: 'Awaiting payment', when: 'Tue 08:47' },
  { name: 'L. Ferreira', guests: 0, status: 'Confirmed', when: 'Tue 19:23' },
];
---

<div
  class="card overflow-hidden shadow-card"
  data-demo
  data-capacity={CAPACITY}
  data-seeded={SEEDED}
>
  <p
    class="border-b border-border bg-accent-wash px-5 py-3 text-sm text-text-muted"
  >
    <strong class="font-semibold text-text">Demonstration.</strong> Fictional
    club, fictional data. Everything runs in your browser — nothing is sent or
    stored.
  </p>

  <div class="grid gap-0 lg:grid-cols-2">
    <!-- ── Member-facing ─────────────────────────────────────────── -->
    <div class="border-border p-6 sm:p-8 lg:border-r">
      <p class="eyebrow">1 — What the member sees</p>

      <div class="mt-5 rounded-lg border border-border bg-surface-sunken p-5">
        <h3 class="font-display text-lg font-bold">
          Thursday Night Championship
        </h3>
        <p class="mt-1 text-sm text-text-muted">
          Riverside Club &middot; <span data-demo-date>Thursday</span> &middot;
          7:00pm
        </p>
        <p class="mt-3 text-sm">
          <span class="font-semibold" data-demo-remaining>{CAPACITY - SEEDED}</span>
          <span class="text-text-muted"> of {CAPACITY} places remaining</span>
        </p>
      </div>

      <form class="mt-6 space-y-4" data-demo-form novalidate>
        <div>
          <label
            for="demo-name"
            class="block text-sm font-medium">Full name</label
          >
          <input
            id="demo-name"
            name="name"
            type="text"
            autocomplete="off"
            required
            class="field mt-1.5"
          />
        </div>

        <div>
          <label for="demo-email" class="block text-sm font-medium">Email</label>
          <input
            id="demo-email"
            name="email"
            type="email"
            autocomplete="off"
            required
            class="field mt-1.5"
          />
        </div>

        <div>
          <label for="demo-guests" class="block text-sm font-medium"
            >Guests</label
          >
          <select
            id="demo-guests"
            name="guests"
            class="field mt-1.5"
          >
            <option value="0">Just me</option>
            <option value="1">1 guest</option>
            <option value="2">2 guests</option>
            <option value="3">3 guests</option>
          </select>
        </div>

        <p
          class="hidden text-sm text-danger"
          data-demo-error
          role="alert"
        >
        </p>

        <button type="submit" class="btn btn-primary w-full">
          Register for this event
        </button>
      </form>
    </div>

    <!-- ── Automation + staff view ───────────────────────────────── -->
    <div class="bg-surface-sunken p-6 sm:p-8">
      <div data-demo-idle>
        <p class="eyebrow">2 — What happens automatically</p>
        <p class="mt-5 text-sm leading-relaxed text-text-muted">
          Submit the form to see the sequence that would fire: the member's
          confirmation, the reminder before the event, the follow-up
          afterwards, and the row that appears for staff.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-text-muted">
          <li class="flex gap-3">
            <span aria-hidden="true" class="text-accent">&#9679;</span>
            No spreadsheet to update
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="text-accent">&#9679;</span>
            No manual confirmation emails
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="text-accent">&#9679;</span>
            No chasing no-shows after the event
          </li>
        </ul>
      </div>

      <div data-demo-result hidden aria-live="polite">
        <p class="eyebrow">2 — What happens automatically</p>
        <h3
          class="mt-3 font-display text-lg font-bold"
          data-demo-result-heading
          tabindex="-1"
        >
        </h3>

        <ol class="mt-6 space-y-4" data-demo-timeline></ol>

        <p class="eyebrow mt-10">3 — What staff see</p>
        <div class="mt-4 overflow-x-auto rounded-lg border border-border bg-surface">
          <table class="w-full min-w-[26rem] text-left text-sm">
            <caption class="sr-only">
              Registrations for Thursday Night Championship
            </caption>
            <thead class="border-b border-border text-xs uppercase tracking-wide text-text-muted">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-semibold">Member</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Guests</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Status</th>
                <th scope="col" class="px-4 py-2.5 font-semibold">Received</th>
              </tr>
            </thead>
            <tbody data-demo-rows>
              {
                seedRows.map((r) => (
                  <tr class="border-b border-border last:border-0">
                    <td class="px-4 py-2.5">{r.name}</td>
                    <td class="px-4 py-2.5">{r.guests}</td>
                    <td class="px-4 py-2.5 text-text-muted">{r.status}</td>
                    <td class="px-4 py-2.5 text-text-muted">{r.when}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <button type="button" class="btn btn-secondary mt-6" data-demo-reset>
          Reset demo
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-demo-form]')!;
    const idle = root.querySelector<HTMLElement>('[data-demo-idle]')!;
    const result = root.querySelector<HTMLElement>('[data-demo-result]')!;
    const heading = root.querySelector<HTMLElement>('[data-demo-result-heading]')!;
    const timeline = root.querySelector<HTMLElement>('[data-demo-timeline]')!;
    const rows = root.querySelector<HTMLElement>('[data-demo-rows]')!;
    const remaining = root.querySelector<HTMLElement>('[data-demo-remaining]')!;
    const dateLabel = root.querySelector<HTMLElement>('[data-demo-date]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-demo-error]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-demo-reset]')!;

    const capacity = Number(root.dataset.capacity ?? 120);
    const seeded = Number(root.dataset.seeded ?? 0);

    /** Next Thursday, so the demo never reads as stale. */
    const eventDate = (() => {
      const d = new Date();
      d.setDate(d.getDate() + ((4 - d.getDay() + 7) % 7 || 7));
      return d;
    })();

    const fmtDate = new Intl.DateTimeFormat('en-AU', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });
    const fmtShort = new Intl.DateTimeFormat('en-AU', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
    });
    const fmtTime = new Intl.DateTimeFormat('en-AU', {
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });

    dateLabel.textContent = fmtDate.format(eventDate);

    const dayBefore = new Date(eventDate);
    dayBefore.setDate(dayBefore.getDate() - 1);
    const dayAfter = new Date(eventDate);
    dayAfter.setDate(dayAfter.getDate() + 1);

    let taken = seeded;

    const step = (
      when: string,
      channel: string,
      title: string,
      bodyText: string
    ) => {
      const li = document.createElement('li');
      li.className = 'rounded-lg border border-border bg-surface p-4';
      li.innerHTML = `
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="font-display text-sm font-semibold"></span>
          <span class="text-xs text-text-muted"></span>
        </div>
        <p class="mt-1 text-xs font-medium text-accent-strong"></p>
        <p class="mt-2 text-sm leading-relaxed text-text-muted"></p>`;
      const [t, w] = li.querySelectorAll('span');
      const [ch, bd] = li.querySelectorAll('p');
      t.textContent = title;
      w.textContent = when;
      ch.textContent = channel;
      bd.textContent = bodyText;
      timeline.append(li);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const guests = Number(data.get('guests') ?? 0);

      // Validate here rather than relying on the browser, so the message
      // sits in a predictable place for screen readers.
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errorBox.textContent = !name
          ? 'Enter a name to continue.'
          : 'Enter a valid email address to continue.';
        errorBox.classList.remove('hidden');
        (!name
          ? form.querySelector<HTMLInputElement>('#demo-name')
          : form.querySelector<HTMLInputElement>('#demo-email')
        )?.focus();
        return;
      }

      errorBox.classList.add('hidden');

      const places = 1 + guests;
      taken = Math.min(capacity, taken + places);
      remaining.textContent = String(capacity - taken);

      const firstName = name.split(/\s+/)[0];

      timeline.replaceChildren();

      step(
        'Immediately',
        'Email to member',
        'Registration confirmed',
        `Hi ${firstName}, you're registered for the Thursday Night Championship on ${fmtDate.format(eventDate)} at 7:00pm${guests ? `, plus ${guests} guest${guests > 1 ? 's' : ''}` : ''}. Your place is held until 6:45pm.`
      );

      step(
        'Immediately',
        'Notification to staff',
        'New registration logged',
        `${name} — ${places} place${places > 1 ? 's' : ''}. Event now at ${taken} of ${capacity}.`
      );

      step(
        fmtShort.format(dayBefore),
        'SMS + email to member',
        'Reminder, 24 hours out',
        `Reminder: your table is confirmed for tomorrow at 7:00pm. Reply CANCEL to release your place — it goes to the waitlist automatically.`
      );

      step(
        fmtShort.format(dayAfter),
        'Email to member',
        'Follow-up and rebooking',
        `Thanks for coming, ${firstName}. Here are the final standings, and next week's event is open for registration — one tap to book the same table.`
      );

      const tr = document.createElement('tr');
      tr.className = 'border-b border-border last:border-0 bg-accent-wash';
      const cells = [name, String(guests), 'Confirmed', fmtTime.format(new Date())];
      cells.forEach((value, i) => {
        const td = document.createElement('td');
        td.className = i >= 2 ? 'px-4 py-2.5 text-text-muted' : 'px-4 py-2.5';
        if (i === 0) td.classList.add('font-medium');
        td.textContent = value;
        tr.append(td);
      });
      rows.append(tr);

      heading.textContent = `${places} place${places > 1 ? 's' : ''} booked — here is everything that fired`;

      idle.hidden = true;
      result.hidden = false;
      heading.focus();
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      timeline.replaceChildren();
      rows.querySelectorAll('tr').forEach((tr, i) => {
        if (i >= 4) tr.remove();
      });
      taken = seeded;
      remaining.textContent = String(capacity - taken);
      result.hidden = true;
      idle.hidden = false;
      form.querySelector<HTMLInputElement>('#demo-name')?.focus();
    });
  }
</script>
