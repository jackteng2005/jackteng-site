---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  /**
   * `tinted` separates adjacent bands without a hard rule. `raised` lifts a
   * band a full step above the page, so one section can dominate instead of
   * every band reading the same.
   */
  variant?: 'default' | 'tinted' | 'raised';
  /** Vertical rhythm. `roomy` is for the band that should dominate. */
  size?: 'default' | 'roomy';
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  lede,
  variant = 'default',
  size = 'default',
  class: className = '',
} = Astro.props;

const headingId = id ? `${id}-heading` : undefined;

const variantClass = {
  default: '',
  tinted: 'bg-surface-sunken',
  raised: 'band-raised',
}[variant];

// Mobile gets a tighter step. At 80px top and bottom, consecutive bands left
// 160px of dead space between them — a fifth of a phone screen, repeatedly.
const sizeClass =
  size === 'roomy'
    ? 'py-20 sm:py-28 lg:py-36'
    : 'py-14 sm:py-20 lg:py-24';
---

<section
  id={id}
  aria-labelledby={headingId}
  class={`${sizeClass} ${variantClass} ${className}`}
>
  <div class="shell">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2
        id={headingId}
        class="mt-3 text-3xl leading-[1.1] font-bold sm:text-4xl lg:text-[2.875rem]"
      >
        {title}
      </h2>
      {
        lede && (
          <p class="mt-5 text-lg leading-relaxed text-text-muted">{lede}</p>
        )
      }
    </div>

    <div class="mt-14">
      <slot />
    </div>
  </div>
</section>
