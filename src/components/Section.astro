---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Tints the band so adjacent sections separate without hard rules. */
  tinted?: boolean;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  lede,
  tinted = false,
  class: className = '',
} = Astro.props;

const headingId = id ? `${id}-heading` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class={`py-20 sm:py-24 ${tinted ? 'bg-surface-sunken' : ''} ${className}`}
>
  <div class="shell">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2
        id={headingId}
        class="mt-3 text-3xl font-bold sm:text-4xl"
      >
        {title}
      </h2>
      {
        lede && (
          <p class="mt-5 text-lg leading-relaxed text-text-muted">{lede}</p>
        )
      }
    </div>

    <div class="mt-14">
      <slot />
    </div>
  </div>
</section>
