---
import EmailLink from '../components/EmailLink.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Section from '../components/Section.astro';
import DashboardArt from '../components/art/DashboardArt.astro';
import HeroArt from '../components/art/HeroArt.astro';
import Base from '../layouts/Base.astro';
import { emailPlain } from '../site';

const description =
  'Jack Teng is a Sydney software developer who replaces spreadsheets, paper and disconnected apps with one system and a single database — bookings, members and payments recorded in one place. Clubs, venues and membership organisations across Australia and New Zealand.';

const commitments = [
  'One system, one source of truth',
  'You deal with me directly',
  'Fixed quote before work starts',
  'Your data exports any time',
];

const problems = [
  {
    title: 'Enquiries land in three different inboxes',
    body: 'Some get answered twice, some never get answered at all, and nobody can tell which is which.',
  },
  {
    title: 'Registration runs on a spreadsheet and a paper diary',
    body: 'One person babysits both, and everything stops when they are away — or when the file quietly forks into two versions.',
  },
  {
    title: 'Confirmations are typed out by hand',
    body: 'Every booking costs someone five minutes of copying names, dates and details into an email.',
  },
  {
    title: 'Nothing follows up automatically',
    body: 'An enquiry that is not answered the same day usually goes quiet — and nobody notices it went quiet.',
  },
  {
    title: 'Staff answer the same five questions daily',
    body: 'Opening hours, dress code, how to book, where to park, whether guests are allowed. Every single day.',
  },
  {
    title: 'The same information lives in four places',
    body: 'A spreadsheet, a paper diary, an inbox and someone’s memory — and nobody can say which one is right today.',
  },
];

const services: { icon: IconName; name: string; summary: string; includes: string[] }[] = [
  {
    icon: 'browser',
    name: 'Websites that earn their keep',
    summary:
      'Fast, mobile-first, and built so a first-time visitor understands what you do and how to reach you within seconds.',
    includes: [
      'Structure and copy worked out with you, not guessed',
      'Responsive build, fast on a phone on mobile data',
      'A clear enquiry path that arrives where staff will see it',
      'Analytics so you know where enquiries come from',
      'Handover, so you can edit content yourself',
    ],
  },
  {
    icon: 'automation',
    name: 'Booking and enquiry automation',
    summary:
      'The repetitive half of front-of-house work, handled by software instead of by staff.',
    includes: [
      'Event, table or membership registration flows',
      'Automatic confirmations, reminders and receipts',
      'Follow-up sequences after an enquiry or an event',
      'Waitlists and capacity handled without intervention',
      'Staff notifications, so nothing depends on refreshing an inbox',
    ],
  },
  {
    icon: 'database',
    name: 'One system, with a proper database behind it',
    summary:
      'The replacement for five disconnected tools. Bookings, members, events and payments held in a single database instead of scattered across spreadsheets, paper and inboxes.',
    includes: [
      'One place for bookings, members, events and payments',
      'A real database, not spreadsheet tabs that fork into versions',
      'Your existing spreadsheet data imported and checked, not abandoned',
      'Dashboards reading from that one source, so the numbers agree',
      'Everything exportable at any time — no lock-in',
    ],
  },
];

const process: { icon: IconName; step: string; title: string; body: string }[] = [
  {
    icon: 'conversation',
    step: 'Step 1',
    title: 'Conversation',
    body: 'A short call about how the work is handled now and where the time actually goes. No pitch.',
  },
  {
    icon: 'document',
    step: 'Step 2',
    title: 'Written proposal',
    body: 'Scope, deliverables, timeline and a fixed price in writing before anything is built.',
  },
  {
    icon: 'build',
    step: 'Step 3',
    title: 'Build, with previews',
    body: 'You see working software as it comes together, not a finished surprise at the end.',
  },
  {
    icon: 'launch',
    step: 'Step 4',
    title: 'Launch and handover',
    body: 'Deployed, documented, and yours — with support afterwards if you want it.',
  },
];

const platformPoints = [
  {
    title: 'One place, not five tabs',
    body: 'Bookings, capacity, payments and enquiries in a single view built around how you actually work.',
  },
  {
    title: 'One record, not four copies of it',
    body: 'Everything reads from and writes to the same database, so there is no re-typing, no version conflict, and no argument about which file is current.',
  },
  {
    title: 'Held in a database, not in files',
    body: 'Structured records with real relationships between members, bookings and payments — encrypted in transit, rather than documents sitting on somebody’s laptop.',
  },
  {
    title: 'Obvious rather than clever',
    body: 'Designed for staff of any technical confidence to use correctly on a busy shift, first time.',
  },
  {
    title: 'Accurate under pressure',
    body: 'Live numbers that stay right when several people are acting on the same information at once.',
  },
  {
    title: 'Yours to keep',
    body: 'Standard technology, no lock-in, and a full export whenever you ask — so you are never dependent on one developer.',
  },
];

const faqs = [
  {
    q: 'How does pricing work if nothing is listed?',
    a: 'We have a short conversation about what you actually need, then I send a written scope with a fixed price. No hourly billing and no surprises mid-project. Work starts on a deposit, with the balance on completion. I quote per project because a one-page site and a members platform are not the same job, and a price list would misrepresent both.',
  },
  {
    q: 'How long does it take?',
    a: 'A small site is usually one to two weeks. Booking and enquiry automation is typically two to four weeks depending on how many steps it replaces. Larger platforms get split into phases so you see something working early rather than waiting months.',
  },
  {
    q: 'Who owns the code and the domain?',
    a: 'You do. The domain should be registered in your own account — never in your developer’s. Code and content transfer to you on final payment, and I will hand over everything needed to run or move it without me.',
  },
  {
    q: 'What does it cost to run afterwards?',
    a: 'Usually very little. Most sites of this kind host for free or a few dollars a month, plus your domain. Automation that sends email or SMS has per-message costs. I will tell you the real running cost before you commit, not after.',
  },
  {
    q: 'We have years of data in spreadsheets. Do we lose it?',
    a: 'No. Migrating what you already have is part of the build, not an extra line item. Existing spreadsheets get imported and checked against the originals, and the messy parts — duplicate members, inconsistent dates, half-finished rows — get sorted out as part of that. You keep your original files too; nothing is thrown away.',
  },
  {
    q: 'Where would our data live, and who can see it?',
    a: 'In a single database hosted with a managed cloud provider — not in files on somebody’s laptop or a shared drive that everyone can edit. Traffic between your staff and the system is encrypted. Hosting location, access levels, backups and how long records are kept are set out in your proposal, because the right answers depend on what you are storing and who needs to reach it. You can export everything at any time.',
  },
  {
    q: 'Do we actually need AI for this?',
    a: 'Often no, and I will say so. A reminder that sends on a schedule does not need a language model. AI earns its place when the task involves reading unstructured text — enquiries, documents, forms — and I will point you at the simpler option when one exists.',
  },
  {
    q: 'We already have a website. Is it a rebuild?',
    a: 'Not necessarily. If the site is serviceable, the cheaper fix is usually to leave it alone and repair the enquiry and booking process behind it. I will tell you which situation you are in.',
  },
];
---

<Base
  title="Software, platforms and automation"
  description={description}
>
  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="overflow-hidden pt-14 pb-20 sm:pt-20 sm:pb-24">
    <div class="shell">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          <p class="eyebrow">
            For clubs, venues &amp; membership organisations
          </p>

          <h1
            class="mt-5 text-4xl leading-[1.08] font-bold sm:text-5xl lg:text-[3.4rem]"
          >
            One system to run your whole operation &mdash; not five apps, a
            spreadsheet and a paper diary.
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-relaxed text-text-muted">
            I&rsquo;m Jack Teng, a software developer in Sydney. I replace
            scattered tools with a single platform and one database behind it,
            so every booking, member and payment is recorded in one place
            &mdash; and nothing depends on who is on shift.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <EmailLink label="Start a conversation" variant="primary" />
            <a href="#services" class="btn btn-secondary">See what I build</a>
          </div>
        </div>

        <div class="lg:pl-4">
          <HeroArt />
        </div>
      </div>

      <ul class="mt-16 flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-8">
        {
          commitments.map((c) => (
            <li class="flex items-center gap-2 text-sm text-text-muted">
              <span aria-hidden="true" class="text-accent">
                <Icon name="check" class="size-4" />
              </span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Problems ──────────────────────────────────────────────────── -->
  <Section
    id="problems"
    eyebrow="The problems I solve"
    title="If any of this sounds familiar, it is fixable."
    lede="None of these need a bigger team. They need the repetitive part handed to software that does not forget."
    tinted
  >
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        problems.map((p) => (
          <li class="card p-6">
            <h3 class="font-display text-base font-bold">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ── Services ──────────────────────────────────────────────────── -->
  <Section
    id="services"
    eyebrow="What I build"
    title="Three ways to start."
    lede="Most projects begin with one of these and grow from there. Every engagement is scoped in writing with a fixed price before any work begins."
  >
    <div class="grid gap-6 lg:grid-cols-3">
      {
        services.map((s) => (
          <article class="card flex flex-col p-7">
            <span
              class="inline-flex size-12 items-center justify-center rounded-xl bg-accent-wash text-accent-strong"
            >
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 font-display text-xl font-bold">{s.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">
              {s.summary}
            </p>
            <ul class="mt-6 space-y-2.5 border-t border-border pt-6">
              {s.includes.map((i) => (
                <li class="flex gap-2.5 text-sm leading-relaxed">
                  <span aria-hidden="true" class="mt-1 shrink-0 text-accent">
                    <Icon name="check" class="size-3.5" />
                  </span>
                  <span class="text-text-muted">{i}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

  </Section>

  <!-- ── Approach ──────────────────────────────────────────────────── -->
  <Section
    id="approach"
    eyebrow="Approach"
    title="One connected system, not five disconnected tools."
    lede="Most operational problems are not caused by missing software. They are caused by information sitting in separate places that do not talk to each other, so people become the glue — re-typing the same booking into a spreadsheet, a diary and an email. One system with one database behind it removes the glue."
    tinted
  >
    <FlowDiagram />

    <div class="mt-20 border-t border-border pt-14">
      <h3 class="font-display text-2xl font-bold">How a project runs</h3>
      <p class="mt-4 max-w-2xl leading-relaxed text-text-muted">
        No open-ended hourly work and no vague statements of work. You know the
        price and the deliverables before anything starts.
      </p>

      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <li class="card p-6">
              <span
                class="inline-flex size-10 items-center justify-center rounded-lg bg-accent-wash text-accent-strong"
              >
                <Icon name={p.icon} class="size-5" />
              </span>
              <p class="mt-5 text-xs font-semibold tracking-wide text-accent-strong uppercase">
                {p.step}
              </p>
              <h4 class="mt-1.5 font-display text-base font-bold">{p.title}</h4>
              <p class="mt-2.5 text-sm leading-relaxed text-text-muted">
                {p.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ── Platform ──────────────────────────────────────────────────── -->
  <Section
    id="platform"
    eyebrow="The result"
    title="Built to be opened every day."
    lede="Operational software is judged on a busy night, not in a demo. Everything it shows comes from one database, so what you are looking at is the record itself — not somebody's copy of it."
  >
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div class="order-2 lg:order-1">
        <div class="rounded-2xl border border-border bg-surface-sunken p-4 shadow-card sm:p-6">
          <DashboardArt />
        </div>
        <p class="mt-4 text-xs text-text-muted">
          Illustrative interface, not a client system.
        </p>
      </div>

      <dl class="order-1 space-y-8 lg:order-2">
        {
          platformPoints.map((p) => (
            <div>
              <dt class="flex items-center gap-3 font-display text-base font-bold">
                <span aria-hidden="true" class="text-accent">
                  <Icon name="check" class="size-4.5" />
                </span>
                {p.title}
              </dt>
              <dd class="mt-2 pl-8 text-sm leading-relaxed text-text-muted">
                {p.body}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- ── About ─────────────────────────────────────────────────────── -->
  <Section id="about" eyebrow="About" title="Who you would be working with." tinted>
    <div class="grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <div class="space-y-5 text-base leading-relaxed text-text-muted">
          <p>
            I&rsquo;m Jack Teng, a software developer based in Sydney. I build
            web platforms and the operational systems behind them &mdash; the
            software a business actually runs on, where being wrong has
            consequences on the night.
          </p>
          <p>
            Most of my work is consolidation. An operation runs on a
            spreadsheet, a paper diary, an inbox and three apps that do not
            talk to each other, and my job is to replace all of it with one
            system and one database &mdash; registrations, bookings,
            scheduling, member records, and the dashboard over the top of
            them. Systems staff use every shift, which have to behave
            predictably while several people act on the same information at
            once. That kind of work rewards understanding a process properly
            before writing any code, which is how I start every project.
          </p>
          <p>
            You deal with me directly. There is no account manager, no handover
            to someone junior, and no agency markup. The trade-off is that I
            take on a small number of projects at a time &mdash; and I will
            tell you honestly if I am not the right fit, or if your problem
            does not need custom software at all.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-2">
        <div class="card p-6">
          <h3 class="font-display text-base font-bold">At a glance</h3>
          <dl class="mt-5 space-y-4 text-sm">
            <div>
              <dt class="text-text-muted">Based in</dt>
              <dd class="mt-0.5 font-medium">Sydney, Australia</dd>
            </div>
            <div>
              <dt class="text-text-muted">Working with clients in</dt>
              <dd class="mt-0.5 font-medium">Australia and New Zealand</dd>
            </div>
            <div>
              <dt class="text-text-muted">Focus</dt>
              <dd class="mt-0.5 font-medium">
                Operational web platforms, booking systems and automation
              </dd>
            </div>
            <div>
              <dt class="text-text-muted">Availability</dt>
              <dd class="mt-0.5 font-medium">
                A small number of projects at a time
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </Section>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <Section
    id="faq"
    eyebrow="Questions"
    title="The things people ask before emailing."
  >
    <div class="max-w-3xl divide-y divide-border">
      {
        faqs.map((f) => (
          <details class="group py-5">
            <summary
              class="flex cursor-pointer items-start justify-between gap-6 font-display text-base font-semibold"
            >
              {f.q}
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-accent transition-transform group-open:rotate-45"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="size-5"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-muted">
              {f.a}
            </p>
          </details>
        ))
      }
    </div>
  </Section>

  <!-- ── Contact ───────────────────────────────────────────────────── -->
  <section id="contact" class="py-20 sm:py-24">
    <div class="shell">
      <div class="card p-8 shadow-card sm:p-12">
        <div class="grid gap-12 lg:grid-cols-2">
          <div>
            <p class="eyebrow">Contact</p>
            <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
              Tell me what is not working.
            </h2>
            <p class="mt-5 leading-relaxed text-text-muted">
              Email is the fastest way to reach me. I read every message myself
              and reply to all genuine enquiries, usually within one business
              day.
            </p>

            <div class="mt-8">
              <EmailLink label="Email me" variant="primary" />
            </div>

            <p class="mt-5 text-sm text-text-muted">
              Or write to <span class="font-medium text-text">{emailPlain}</span>
            </p>
          </div>

          <div class="rounded-lg border border-border bg-surface-sunken p-6">
            <h3 class="font-display text-base font-bold">
              Include these and I can give you a useful answer first time
            </h3>
            <ol class="mt-5 space-y-3 text-sm text-text-muted">
              <li class="flex gap-3">
                <span class="font-display font-bold text-accent-strong">1</span>
                Your organisation, and what it does
              </li>
              <li class="flex gap-3">
                <span class="font-display font-bold text-accent-strong">2</span>
                What is not working right now
              </li>
              <li class="flex gap-3">
                <span class="font-display font-bold text-accent-strong">3</span>
                Roughly when you need it done
              </li>
              <li class="flex gap-3">
                <span class="font-display font-bold text-accent-strong">4</span>
                A budget range, if you have one in mind
              </li>
              <li class="flex gap-3">
                <span class="font-display font-bold text-accent-strong">5</span>
                Your current website, if there is one
              </li>
            </ol>
            <p class="mt-6 text-xs leading-relaxed text-text-muted">
              If the email button opens your mail app with these prompts
              already filled in, just type over them.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
