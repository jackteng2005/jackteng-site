---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import LocaleSwitch from '../components/LocaleSwitch.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import { ui, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  lang?: Lang;
  /**
   * Path of the equivalent page in the other language, e.g. '/zh/' for '/'.
   * Omit on pages with no counterpart (404) — the switch link is hidden.
   */
  altPath?: string;
}

const { title, description, indexable, lang = 'en', altPath } = Astro.props;
const t = ui[lang];
---

<!doctype html>
<!--
  Dark is forced rather than following the visitor's OS: it is the brand, not
  a preference. The light tokens stay defined in global.css so a toggle can be
  added later by flipping this attribute.
-->
<html lang={t.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      indexable={indexable}
      lang={lang}
      altPath={altPath}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:shadow-card"
    >
      {t.skipToContent}
    </a>

    <Nav lang={lang} />
    {altPath && <LocaleSwitch lang={lang} altPath={altPath} />}

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      // Scroll reveal. The `reveal` class is applied here rather than in the
      // markup so that if this script never runs, nothing is left at opacity 0.
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const candidates =
          document.querySelectorAll<HTMLElement>('.card, [data-reveal]');

        // Skip anything taller than 70% of the viewport. Such an element can
        // never be comfortably "entered", so its reveal is unreliable — the
        // contact card at 972px on a 812px screen stayed at opacity 0 and took
        // the whole conversion point of the page with it. A block that size
        // fading in looks wrong regardless.
        const maxHeight = window.innerHeight * 0.7;
        const targets = [...candidates].filter(
          (el) => el.getBoundingClientRect().height <= maxHeight
        );

        targets.forEach((el) => el.classList.add('reveal'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;

              // Stagger by position within the parent grid.
              const siblings = el.parentElement
                ? [...el.parentElement.children]
                : [];
              const index = Math.max(0, siblings.indexOf(el));
              el.style.transitionDelay = `${Math.min(index, 5) * 70}ms`;

              el.classList.add('is-visible');
              observer.unobserve(el);
            });
          },
          // threshold 0: any intersecting pixel is enough. A ratio-based
          // threshold is fragile for tall elements, which is how the bug above
          // happened in the first place.
          { rootMargin: '0px 0px -8% 0px', threshold: 0 }
        );

        targets.forEach((el) => observer.observe(el));

        // Failsafe. Reveal is decoration; content being readable is not
        // negotiable. If the observer does not fire for something — a browser
        // quirk, an odd viewport, a page where it silently never triggers —
        // show it anyway rather than leave it at opacity 0. This has already
        // bitten twice, so it is belt and braces on purpose.
        window.setTimeout(() => {
          document
            .querySelectorAll('.reveal:not(.is-visible)')
            .forEach((el) => el.classList.add('is-visible'));
        }, 2500);
      }
    </script>
  </body>
</html>
